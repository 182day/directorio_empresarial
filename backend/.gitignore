# Dependencias de Node
node_modules/

# Variables de entorno y secretos
.env
.env.local
.env.development
.env.test
.env.production

# Logs de error y ejecuciones
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Carpeta de compilación (en caso de TypeScript / Babel)
dist/
build/

# Archivos del sistema operativo e IDEs
.DS_Store
Thumbs.db
.vscode/
.idea/

# Archivos comprimidos
*.rar

# -------------------------------------------------------------
# SUBIDAS Y ASSETS
# -------------------------------------------------------------

# Carpeta uploads: ignora todo excepto su .gitkeep
src/uploads/*
!src/uploads/.gitkeep

# Carpeta assets: ignora todo el contenido de src/assets/
src/assets/*

# Excepción 1: Permite entrar a la carpeta empresas
!src/assets/empresas/

# Excepción 2: Ignora todo dentro de empresas excepto su .gitkeep
src/assets/empresas/*
!src/assets/empresas/.gitkeep