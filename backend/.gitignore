# Dependencias de Node
node_modules/

# Variables de entorno y secretos
.env
.env.local
.env.development
.env.test
.env.production

# Logs de error y ejecuciones
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Carpeta de compilación (en caso de TypeScript / Babel)
dist/
build/

# Archivos del sistema operativo e IDEs
.DS_Store
Thumbs.db
.vscode/
.idea/

# Subidas de archivos por usuarios (si el backend guarda imágenes/archivos localmente)
uploads/
public/uploads/

# Archivos
*.rar

# Ignora todo dentro de la carpeta documents
src/assets/*

# Pero no ignores el archivo .gitkeep
!src/assets/.gitkeep